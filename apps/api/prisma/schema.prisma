generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  ADMIN
  PURCHASER
  MANAGER
  WAREHOUSE

  @@map("organization_role")
}

enum AccountTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD

  @@map("account_token_purpose")
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED

  @@map("purchase_order_status")
}

enum StockMovementType {
  RECEIPT

  @@map("stock_movement_type")
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(160)
  currency    String       @db.Char(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships Membership[]
  products    Product[]
  suppliers   Supplier[]
  locations   Location[]
  purchaseOrders PurchaseOrder[]

  @@map("organizations")
}

model Supplier {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(160)
  contactName    String?      @map("contact_name") @db.VarChar(120)
  email          String?      @db.VarChar(254)
  phone          String?      @db.VarChar(32)
  address        String?      @db.VarChar(500)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@index([organizationId, archivedAt])
  @@map("suppliers")
}

model Location {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(120)
  address        String?      @db.VarChar(500)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]
  stockMovements StockMovement[]
  stockLevels    StockLevel[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@index([organizationId, archivedAt])
  @@map("locations")
}

model Product {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  sku            String       @db.VarChar(64)
  name           String       @db.VarChar(160)
  description    String?      @db.VarChar(2000)
  unit           String       @db.VarChar(32)
  archivedAt     DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrderLines PurchaseOrderLine[]
  stockMovements     StockMovement[]
  stockLevels        StockLevel[]

  @@unique([organizationId, sku])
  @@unique([organizationId, id])
  @@index([organizationId, archivedAt])
  @@map("products")
}

model PurchaseOrder {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  number         Int
  supplierId     String              @map("supplier_id") @db.Uuid
  locationId     String              @map("location_id") @db.Uuid
  status         PurchaseOrderStatus @default(DRAFT)
  note           String?             @db.VarChar(1000)
  createdById    String              @map("created_by_id") @db.Uuid
  decidedById    String?             @map("decided_by_id") @db.Uuid
  decisionNote   String?             @map("decision_note") @db.VarChar(1000)
  decidedAt      DateTime?           @map("decided_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier       Supplier            @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  location       Location            @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  createdBy      User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  decidedBy      User?               @relation("PurchaseOrderDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  lines          PurchaseOrderLine[]
  receipts       GoodsReceipt[]

  @@unique([organizationId, number])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  purchaseOrderId  String        @map("purchase_order_id") @db.Uuid
  productId        String        @map("product_id") @db.Uuid
  quantity         Int
  unitPrice        Decimal       @map("unit_price") @db.Decimal(12, 2)
  receivedQuantity Int           @default(0) @map("received_quantity")
  purchaseOrder    PurchaseOrder @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Cascade)
  product          Product       @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  receiptLines     GoodsReceiptLine[]

  @@unique([purchaseOrderId, productId])
  @@unique([purchaseOrderId, id])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  purchaseOrderId String             @map("purchase_order_id") @db.Uuid
  note            String?            @db.VarChar(500)
  receivedById    String             @map("received_by_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  purchaseOrder   PurchaseOrder      @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Restrict)
  receivedBy      User               @relation("GoodsReceiptReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  lines           GoodsReceiptLine[]

  @@index([organizationId, purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String            @id @default(uuid()) @db.Uuid
  goodsReceiptId      String            @map("goods_receipt_id") @db.Uuid
  purchaseOrderId     String            @map("purchase_order_id") @db.Uuid
  purchaseOrderLineId String            @map("purchase_order_line_id") @db.Uuid
  quantity            Int
  receipt             GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  orderLine           PurchaseOrderLine @relation(fields: [purchaseOrderId, purchaseOrderLineId], references: [purchaseOrderId, id], onDelete: Restrict)
  stockMovement       StockMovement?

  @@unique([goodsReceiptId, purchaseOrderLineId])
  @@map("goods_receipt_lines")
}

model StockMovement {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  productId          String            @map("product_id") @db.Uuid
  locationId         String            @map("location_id") @db.Uuid
  type               StockMovementType
  quantity           Int
  goodsReceiptLineId String?           @unique @map("goods_receipt_line_id") @db.Uuid
  createdById        String            @map("created_by_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  product            Product           @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  location           Location          @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  receiptLine        GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Restrict)
  createdBy          User              @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, productId, locationId, createdAt])
  @@map("stock_movements")
}

model StockLevel {
  organizationId String   @map("organization_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  locationId     String   @map("location_id") @db.Uuid
  quantity       Int
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  product        Product  @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  location       Location @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, productId, locationId])
  @@map("stock_levels")
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  email       String       @unique @db.VarChar(254)
  displayName String       @map("display_name") @db.VarChar(120)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships Membership[]
  credential  PasswordCredential?
  sessions    Session[]
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  authVersion Int @default(0) @map("auth_version")
  accountTokens AccountToken[]
  createdPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  decidedPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderDecidedBy")
  goodsReceipts GoodsReceipt[] @relation("GoodsReceiptReceivedBy")
  stockMovements StockMovement[] @relation("StockMovementCreatedBy")

  @@map("users")
}

model PasswordCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  authVersion Int @default(0) @map("auth_version")
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AccountToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  email String @db.VarChar(254)
  purpose AccountTokenPurpose
  tokenHash String @unique @map("token_hash") @db.Char(64)
  authVersion Int @map("auth_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("account_tokens")
}

model Membership {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  roles          OrganizationRole[]
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}