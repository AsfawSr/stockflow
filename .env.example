# Copy to .env next to docker-compose.yml and replace every placeholder.
# Never commit the real .env file.

# PostgreSQL superuser password for the bundled database container.
POSTGRES_PASSWORD=choose-a-long-random-password

# Connection string the API and migrations use inside the compose network.
DATABASE_URL=postgresql://stockflow:choose-a-long-random-password@db:5432/stockflow

# Public origin of the web application (HTTPS required in production).
WEB_ORIGIN=https://stockflow.example.com

# Domain the TLS ingress serves; must match WEB_ORIGIN's host.
# `localhost` uses Caddy's local CA for development-style HTTPS.
DOMAIN=stockflow.example.com

# Where the web server reaches the API inside the compose network.
API_BASE_URL=http://api:3001

# Outbound email. Production refuses the development file transport.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=postmaster@example.com
SMTP_PASSWORD=smtp-password
MAIL_FROM=StockFlow <no-reply@example.com>

# Shared fixed-window rate limiting across API processes.
RATE_LIMIT_STORE=database

# Number of trusted reverse-proxy hops in front of the API (0 = none).
TRUSTED_PROXY_HOPS=0
