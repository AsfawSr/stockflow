{
  "name": "stockflow",
  "version": "0.1.0",
  "private": true,
  "description": "A multi-tenant inventory and procurement platform.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@stockflow/web",
    "dev:api": "npm run start:dev --workspace=@stockflow/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.6.1"
}