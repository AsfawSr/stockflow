{
  "name": "stockflow",
  "version": "0.1.0",
  "private": true,
  "description": "A multi-tenant inventory and procurement platform.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@stockflow/web",
    "dev:api": "npm run start:dev --workspace=@stockflow/api",
    "db:generate": "npm run db:generate --workspace=@stockflow/api",
    "db:validate": "npm run db:validate --workspace=@stockflow/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  },
  "packageManager": "npm@11.6.1"
}